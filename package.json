    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwind": "^2.2.12",
    "steiger": "^0.5.11",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.56.1",
