{
  "name": "zabekame",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format:check": "prettier --check '**/*.{ts,tsx,js,cjs,json,svg}'",
    "format:write": "prettier --write --cache '**/*.{ts,tsx,js,cjs,json,svg}'",
    "lint:check": "eslint './src/**/*.{ts,tsx,js,cjs,mjs}'",
    "lint:fix": "eslint --fix --cache './src/**/*.{ts,tsx,js,cjs,mjs}'",
    "arch:check": "steiger ./src",
